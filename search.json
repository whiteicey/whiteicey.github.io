---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags": [{% for tag in post.tags %}{{ tag | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "subtitle": {{ post.subtitle | default: "" | jsonify }},
    "snippet": {{ post.content | strip_html | strip_newlines | truncate: 160 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
